.topline {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding-bottom: 18rpx;
  border-bottom: 1rpx solid var(--ink);
}

.brand {
  display: block;
  font-size: 48rpx;
  line-height: 1;
  letter-spacing: 0.16em;
}

.calendar {
  padding-left: 20rpx;
  text-align: right;
}

.date-meta,
.calendar-sub {
  display: block;
}

.date-meta {
  font-size: 18rpx;
}

.calendar-sub {
  margin-top: 4rpx;
  color: var(--muted);
  font-size: 15rpx;
}

.time-center {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 20rpx 0 6rpx;
  text-align: center;
}

.time-kicker,
.time-detail {
  color: var(--muted);
  font-family: monospace;
  font-size: 16rpx;
  letter-spacing: 0.1em;
}

.pillars-small {
  display: flex;
  gap: 18rpx;
  margin-top: 9rpx;
  color: var(--muted);
  font-family: monospace;
  font-size: 18rpx;
  letter-spacing: 0.04em;
}

.time-pillar {
  margin-top: 10rpx;
  color: var(--accent);
  font-size: 66rpx;
  line-height: 1.1;
  letter-spacing: 0.16em;
}

.time-detail {
  margin-top: 7rpx;
  color: var(--ink);
  font-family: inherit;
  font-size: 18rpx;
}

.state-heading {
  padding: 24rpx 0 22rpx;
}

.state-title-row {
  display: flex;
  align-items: baseline;
  gap: 18rpx;
}

.state-index {
  color: var(--muted);
  font-family: monospace;
  font-size: 20rpx;
}

.state-name {
  font-size: 48rpx;
  letter-spacing: 0.12em;
}

.state-title {
  display: block;
  margin-top: 14rpx;
  font-size: 29rpx;
  letter-spacing: 0.12em;
}

.state-control-row {
  display: flex;
  align-items: center;
  gap: 20rpx;
  margin-top: 16rpx;
}

.state-picker {
  padding: 12rpx 0;
  border-bottom: 1rpx solid var(--line);
  color: var(--muted);
  font-size: 20rpx;
}

.state-picker text {
  margin-left: 16rpx;
  color: var(--accent);
}

.reset-button {
  color: var(--accent);
  font-size: 20rpx;
}

.now-card {
  position: relative;
  min-height: 720rpx;
  overflow: hidden;
  padding: 32rpx 28rpx 26rpx;
  border-radius: 22rpx;
  background: linear-gradient(145deg, #21332a, #101711 75%);
  color: #f0eee3;
}

.state-growth .now-card {
  background: linear-gradient(145deg, #f0eee4, #dcded2);
  color: var(--ink);
}

.state-transform .now-card {
  background: linear-gradient(145deg, #514434, #171a14);
}

.card-topline,
.mini-player,
.tone-current {
  display: flex;
  align-items: center;
}

.card-topline {
  justify-content: space-between;
  font-size: 28rpx;
}

.scene-code {
  color: #b7c4b4;
  font-size: 16rpx;
}

.scene-copy {
  position: relative;
  z-index: 2;
  margin-top: 44rpx;
  width: 68%;
}

.scene-copy .eyebrow {
  color: #a7b3a1;
}

.state-growth .scene-copy .eyebrow {
  color: var(--muted);
}

.scene-title {
  display: block;
  margin-top: 22rpx;
  font-size: 42rpx;
  line-height: 1.45;
  letter-spacing: 0.12em;
}

.scene-caption {
  display: block;
  margin-top: 18rpx;
  color: #a9b4a5;
  font-size: 19rpx;
  line-height: 1.8;
}

.state-growth .scene-caption {
  color: var(--muted);
}

.orb-wrap {
  position: absolute;
  top: 194rpx;
  right: 38rpx;
  width: 360rpx;
  height: 360rpx;
}

.orb-orbit,
.orb-core {
  position: absolute;
  border-radius: 50%;
}

.orb-orbit {
  inset: 0;
  border: 1rpx solid #ffffff20;
}

.orbit-two {
  inset: 42rpx;
}

.orb-core {
  top: 128rpx;
  left: 128rpx;
  width: 104rpx;
  height: 104rpx;
  background: radial-gradient(circle at 35% 30%, #dedbc7, var(--accent) 68%, #141d16);
  box-shadow: 0 0 0 20rpx #ffffff0b, 0 0 60rpx var(--accent);
  animation: orb-breathe 4s ease-in-out infinite;
}

.orb-label {
  position: absolute;
  top: 280rpx;
  left: 50%;
  transform: translateX(-50%);
  white-space: nowrap;
  color: #b6c0b1;
  font-size: 17rpx;
}

.mini-player {
  position: absolute;
  right: 28rpx;
  bottom: 116rpx;
  left: 28rpx;
  z-index: 3;
  gap: 18rpx;
  padding: 16rpx 18rpx;
  border-radius: 60rpx;
  background: #f1f0e4ed;
  color: var(--ink);
  backdrop-filter: blur(10rpx);
}

.track-cover {
  width: 64rpx;
  height: 64rpx;
  flex: 0 0 64rpx;
  border-radius: 50%;
  background: linear-gradient(145deg, var(--accent), #25332a);
}

.cover-1,
.cover-2,
.cover-3 {
  background: linear-gradient(145deg, #b9bca9, #536f67);
}

.cover-5,
.cover-6,
.cover-7,
.cover-8 {
  background: linear-gradient(145deg, #d5bd8c, #7d5c39);
}

.cover-9,
.cover-10 {
  background: linear-gradient(145deg, #88a3a0, #334f5b);
}

.track-copy {
  min-width: 0;
  flex: 1;
}

.track-title,
.track-sub {
  display: block;
}

.track-title {
  font-size: 24rpx;
}

.track-sub {
  margin-top: 6rpx;
  color: #73806d;
  font-size: 17rpx;
}

.play-button {
  width: 72rpx;
  height: 72rpx;
  border: 1rpx solid #57756a;
  border-radius: 50%;
  color: #3a6357;
  font-family: sans-serif;
  font-size: 24rpx;
  line-height: 72rpx;
  text-align: center;
}

.wave {
  position: absolute;
  right: 30rpx;
  bottom: 50rpx;
  left: 30rpx;
  display: flex;
  height: 66rpx;
  align-items: center;
  justify-content: space-between;
  opacity: 0.35;
}

.wave-bar {
  width: 3rpx;
  min-height: 8rpx;
  border-radius: 8rpx;
  background: currentColor;
  transform-origin: center;
}

.wave.playing .wave-bar {
  animation: wave-pulse 0.9s ease-in-out infinite alternate;
}

.card-footer {
  position: absolute;
  bottom: 18rpx;
  left: 28rpx;
  color: #aab4a7;
  font-size: 17rpx;
  letter-spacing: 0.12em;
}

.tone-dock {
  padding: 26rpx 0 18rpx;
  border-bottom: 1rpx solid var(--line);
}

.tone-current {
  gap: 12rpx;
  color: var(--muted);
  font-size: 19rpx;
}

.tone-dot {
  width: 12rpx;
  height: 12rpx;
  flex: 0 0 12rpx;
  border-radius: 50%;
}

.tone-scroll {
  margin-top: 18rpx;
  white-space: nowrap;
}

.tone-list {
  display: inline-flex;
  gap: 12rpx;
}

.tone-button {
  display: inline-flex;
  align-items: center;
  gap: 10rpx;
  padding: 11rpx 16rpx;
  border: 1rpx solid transparent;
  border-radius: 8rpx;
  color: var(--muted);
  font-size: 20rpx;
}

.tone-button.active {
  border-color: var(--accent);
  background: #ffffff56;
  color: var(--ink);
}

.quick-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 16rpx;
  margin-top: 24rpx;
}

.quick-grid button {
  display: flex;
  min-height: 94rpx;
  flex-direction: column;
  justify-content: center;
  gap: 10rpx;
  padding: 0 18rpx;
  border: 1rpx solid var(--line);
  border-radius: 14rpx;
  text-align: left;
}

.quick-grid text:first-child {
  font-size: 21rpx;
}

.quick-grid text:last-child {
  color: var(--muted);
  font-size: 17rpx;
}

.demo-note {
  display: block;
  margin-top: 26rpx;
  color: #9a9f92;
  font-size: 16rpx;
  text-align: center;
}

@keyframes orb-breathe {
  0%, 100% { transform: scale(0.96); opacity: 0.86; }
  50% { transform: scale(1.04); opacity: 1; }
}

@keyframes wave-pulse {
  from { transform: scaleY(0.38); opacity: 0.55; }
  to { transform: scaleY(1); opacity: 1; }
}
